# NoneBot2 驱动配置
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["."]

# 机器人主人的 QQ 号（拥有管理权限）
QQBOT_OWNER=请填写你的QQ号

# B站/视频链接自动解析插件（nonebot-plugin-parser）
# PARSER_MAX_SIZE=50          # 单个资源最大 MB
# PARSER_DURATION_MAXIMUM=480 # 视频/音频最大时长(秒)
# PARSER_BILI_CK=             # B站Cookie(可选，可解锁更高清晰度与AI总结)
