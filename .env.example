# NoneBot2 驱动配置
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["."]

# 机器人主人的 QQ 号（拥有管理权限）
QQBOT_OWNER=请填写你的QQ号

# 可选：测试特权群（默认空，生产请勿配置）
# QQBOT_TEST_PRIVILEGED_GROUPS=
# QQBOT_TEST_OWNER_UIDS=

# OneBot 反向 WS 鉴权 token（强烈建议必配；空 token 时任何能连上 HOST:PORT 的进程可伪造事件）
ONEBOT_ACCESS_TOKEN=请填写随机长token

# ===== 业务密钥（勿写入 plugins/**/config.json 等源码树） =====
# auto_chat（DeepSeek）
DEEPSEEK_API_KEY=sk-请填写
# news 晨报 AI（智谱 GLM）
GLM_API_KEY=请填写
GLM_MODEL=glm-4-flash
# chat_stats PostgreSQL
PG_DSN=postgresql://user:password@127.0.0.1:5432/dbname
