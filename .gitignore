# ===== 敏感配置（禁止上传） =====
.env
.env.*
!.env.example

# 运行时状态与配置（含 QQ 号/群号/密钥）
plugins/**/state.json
plugins/**/history.json
plugins/**/db.json
plugins/**/words_state.json
plugins/**/push_config.json
plugins/**/bindings.json
plugins/**/auto_approve.json
plugins/**/config.json
plugins/**/ai_config.json
plugins/**/repeater_state.json
plugins/**/join_state.json
**/stats.db
**/stats.db-*

# 损坏状态文件的自动备份（含 QQ 号）
*.corrupt-*

# 备份与临时文件
*.bak*
*.log
.deleted/

# 审计文档（含服务器 IP、SSH 用户、内部路径等运维细节，禁止上传）
AUDIT-*.md
REVIEW-*.md
SECURITY-FIX-*.md

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# 图片缓存
plugins/**/cache/
plugins-disabled/**/cache/
plugins/**/approve_guard.json
plugins/**/maintenance.json
